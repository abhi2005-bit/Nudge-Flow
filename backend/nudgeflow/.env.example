
NUDGEFLOW_APP_NAME=NudgeFlow API
NUDGEFLOW_APP_VERSION=0.1.0
NUDGEFLOW_ENVIRONMENT=development
NUDGEFLOW_DEBUG=false
NUDGEFLOW_DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/nudgeflow
NUDGEFLOW_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
NUDGEFLOW_JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
NUDGEFLOW_ACCESS_TOKEN_EXPIRE_MINUTES=30

# WhatsApp Cloud API (mock messaging remains active unless explicitly enabled)
NUDGEFLOW_WHATSAPP_ENABLED=false
NUDGEFLOW_WHATSAPP_ACCESS_TOKEN=replace-with-meta-cloud-api-token
NUDGEFLOW_WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
NUDGEFLOW_WHATSAPP_API_VERSION=v25.0

# Groq LLM configuration for customer message extraction and drafting
NUDGEFLOW_LLM_API_KEY=replace-with-groq-api-key-gsk
NUDGEFLOW_LLM_MODEL=openai/gpt-oss-20b
NUDGEFLOW_LLM_TIMEOUT_SECONDS=15
